<div class="admin-top-row">
  <h1 style="margin-bottom:0;">Sản phẩm</h1>
  <a class="btn btn--solid" href="/admin/san-pham/moi">+ Thêm sản phẩm</a>
</div>

<% if (products.length === 0) { %>
  <p class="admin-empty">Chưa có sản phẩm nào.</p>
<% } else { %>
  <table class="admin-table">
    <thead>
      <tr>
        <th></th>
        <th>Tên sản phẩm</th>
        <th>Danh mục</th>
        <th>Giá</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% products.forEach(function(sp){ %>
        <% const dm = danhMucShop.find(function(d){ return d.slug === sp.danh_muc; }); %>
        <tr>
          <td>
            <% if (sp.hinh_anh) { %>
              <img class="admin-thumb" src="/images/products/<%= sp.hinh_anh %>" alt="<%= sp.ten %>">
            <% } else { %>
              <span class="admin-thumb-icon"><svg width="24" height="24"><use href="#icon-<%= sp.icon %>"/></svg></span>
            <% } %>
          </td>
          <td><%= sp.ten %></td>
          <td><%= dm ? dm.ten : sp.danh_muc %></td>
          <td><%= sp.gia.toLocaleString('vi-VN') %>₫</td>
          <td>
            <div class="admin-actions">
              <a class="text-link" href="/cua-hang/<%= sp.slug %>" target="_blank" rel="noopener">Xem</a>
              <a class="text-link" href="/admin/san-pham/<%= sp.slug %>/sua">Sửa</a>
              <form method="POST" action="/admin/san-pham/<%= sp.slug %>/xoa" onsubmit="return confirm('Xóa sản phẩm này? Không thể hoàn tác.');">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit">Xóa</button>
              </form>
            </div>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
<% } %>
