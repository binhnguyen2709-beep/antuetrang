<section class="section">
  <div class="wrap contact-grid">
    <div>
      <h1>Đặt hàng</h1>
      <p>Điền thông tin giao hàng bên dưới. Chúng tôi giao hàng và thu tiền tận nơi (thanh toán khi nhận hàng - COD).</p>

      <% if (loi) { %>
        <div class="admin-error"><%= loi %></div>
      <% } %>

      <form method="POST" action="/dat-hang">
        <div class="field">
          <label for="ho_ten">Họ và tên</label>
          <input type="text" id="ho_ten" name="ho_ten" required value="<%= da_nhap.ho_ten || '' %>">
        </div>
        <div class="field">
          <label for="dien_thoai">Số điện thoại</label>
          <input type="tel" id="dien_thoai" name="dien_thoai" required value="<%= da_nhap.dien_thoai || '' %>">
        </div>
        <div class="field">
          <label for="dia_chi">Địa chỉ giao hàng</label>
          <input type="text" id="dia_chi" name="dia_chi" required value="<%= da_nhap.dia_chi || '' %>">
        </div>
        <div class="field">
          <label for="ghi_chu">Ghi chú (không bắt buộc)</label>
          <textarea id="ghi_chu" name="ghi_chu" rows="3"><%= da_nhap.ghi_chu || '' %></textarea>
        </div>
        <button type="submit" class="btn btn--solid">Xác nhận đặt hàng</button>
      </form>
    </div>

    <div>
      <h2>Đơn hàng của bạn</h2>
      <ul class="spec-list">
        <% items.forEach(function(i){ %>
          <li><b><%= i.ten %> × <%= i.soLuong %></b><span><%= i.thanhTien.toLocaleString('vi-VN') %>₫</span></li>
        <% }); %>
      </ul>
      <div class="cart-summary">
        <span>Tổng cộng</span>
        <span class="cart-summary__total"><%= tongTien.toLocaleString('vi-VN') %>₫</span>
      </div>
      <p style="margin-top:16px;"><a class="text-link" href="/gio-hang">Quay lại giỏ hàng</a></p>
    </div>
  </div>
</section>
