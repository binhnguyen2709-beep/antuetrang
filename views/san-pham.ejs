<section class="section">
  <div class="wrap">
    <p class="eyebrow-note"><a class="text-link" href="/cua-hang">Cửa Hàng</a> / <%= danhMuc ? danhMuc.ten : '' %></p>

    <div class="product-hero">
      <div class="product-hero__icon">
        <% if (sp.hinh_anh) { %>
          <img src="/images/products/<%= sp.hinh_anh %>" alt="<%= sp.ten %>" style="width:100%; height:100%; object-fit:cover;">
        <% } else { %>
          <svg><use href="#icon-<%= sp.icon %>"/></svg>
        <% } %>
      </div>
      <div>
        <h1><%= sp.ten %></h1>
        <p class="product-price"><%= sp.gia.toLocaleString('vi-VN') %>₫</p>
        <p class="wide"><%= sp.mo_ta %></p>

        <ul class="spec-list">
          <li><b>Chất liệu</b><span><%= sp.chat_lieu %></span></li>
          <li><b>Danh mục</b><span><%= danhMuc ? danhMuc.ten : '' %></span></li>
        </ul>

        <form method="POST" action="/gio-hang/them" style="display:flex; align-items:flex-end; gap:14px; flex-wrap:wrap;">
          <input type="hidden" name="slug" value="<%= sp.slug %>">
          <input type="hidden" name="quay_lai" value="/gio-hang">
          <div class="field" style="margin-bottom:0;">
            <label for="qty">Số lượng</label>
            <input type="number" id="qty" name="qty" value="1" min="1" max="20" style="width:90px;">
          </div>
          <button type="submit" class="btn btn--solid">Thêm vào giỏ hàng</button>
        </form>
        <p style="margin-top:16px;"><a class="text-link" href="/ho-tro-lien-he">Hoặc liên hệ để được tư vấn trước khi đặt</a></p>
      </div>
    </div>
  </div>
</section>

<% if (lienQuan && lienQuan.length) { %>
<section class="section section--tinted">
  <div class="wrap">
    <h2>Sản phẩm liên quan</h2>
    <div class="product-list">
      <% lienQuan.forEach(function(rp){ %>
        <%- include('partials/product-row', { sp: rp, currentPath }) %>
      <% }); %>
    </div>
  </div>
</section>
<% } %>
