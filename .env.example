PORT=3000
NODE_ENV=production

# Random long string, used to sign session cookies (cart + admin login).
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me

# Set to true only once the site is served over HTTPS (otherwise login cookies won't be set).
COOKIE_SECURE=false
# Set to true if the app runs behind a reverse proxy (e.g. Nginx) that terminates HTTPS.
TRUST_PROXY=false

# Admin panel login (/admin). Generate a new hash with:
# node scripts/hash-password.js "your-new-password"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=change-me
